# Copy this file to .env and fill in real values. Never commit the real .env.

# Optional. Either of these (not both needed) enables the LLM phrasing layer
# in backend/app/reasoning/llm_augment.py (natural-language summary only -
# the LLM never generates facts, numbers, or citations; see that file's
# docstring). ANTHROPIC_API_KEY is checked first; if unset, GROQ_API_KEY is
# used instead. The system is fully functional WITHOUT either key - this is
# a phrasing enhancement, not a dependency.
#
# NEVER put a real key in this file or commit a filled-in .env - copy this
# to .env (gitignored) or set these as real environment variables / secrets
# in your deployment platform instead. Never embed a key in any client-side
# file (frontend/demo.html is intentionally LLM-free for this reason).
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Port for local uvicorn runs (docker-compose / Docker default to 8000).
PORT=8000
